diff --git a/flagscale/train/utils/flaggems.py b/flagscale/train/utils/flaggems.py
index ef8f690..2d3fe62 100644
--- a/flagscale/train/utils/flaggems.py
+++ b/flagscale/train/utils/flaggems.py
@@ -152,13 +152,31 @@ def enable_flaggems(hardware: Any, device: Any, platform: Any = None) -> bool:
         exclude = [str(name) for name in exclude] or None
     if isinstance(exclude, str) and exclude.strip().lower() in {"", "none"}:
         exclude = None
+
+    # ``include`` registers ONLY the named ops (flag_gems.only_enable) instead of
+    # the full catalogue.  Measured on KunlunXIN (2026-11-10, problem29
+    # ATTRIBUTION.md): of ten representative ops nine are *slower* under
+    # FlagGems (layer_norm 0.04x, sum 0.03x, add/max slower), while the patched
+    # gelu family is 5.8-16.5x faster -- so full enable is a net regression and
+    # only a curated include list pays off.  Same accepted forms as exclude.
+    include = get("flaggems_include", None)
+    if include is not None and not isinstance(include, str):
+        include = [str(name) for name in include] or None
+    if isinstance(include, str) and include.strip().lower() in {"", "none"}:
+        include = None
+
     record = bool(get("flaggems_record", False))
     log_path = get("flaggems_log_path", None)
 
     try:
-        flag_gems.enable(unused=exclude, record=record, once=True, path=log_path)
+        if include:
+            flag_gems.only_enable(include=include, record=record, once=True,
+                                  path=log_path)
+        else:
+            flag_gems.enable(unused=exclude, record=record, once=True, path=log_path)
     except Exception as exc:
-        message = f"flag_gems.enable(...) failed: {type(exc).__name__}: {exc}"
+        message = (f"flag_gems.{'only_enable' if include else 'enable'}(...) failed: "
+                   f"{type(exc).__name__}: {exc}")
         if required:
             raise RuntimeError(message) from exc
         print(f"[flaggems] WARNING: {message}", flush=True)
@@ -168,7 +186,9 @@ def enable_flaggems(hardware: Any, device: Any, platform: Any = None) -> bool:
     print(
         f"[flaggems] enabled vendor={os.environ.get('GEMS_VENDOR', 'auto-detect')} "
         f"version={getattr(flag_gems, '__version__', '?')} "
-        f"exclude={'default' if exclude is None else exclude} ({extra})",
+        f"mode={'include' if include else 'full'} "
+        f"ops={'default' if (exclude if include is None else include) is None else (include if include else exclude)} "
+        f"({extra})",
         flush=True,
     )
     return True
